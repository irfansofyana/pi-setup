{
  "name": "@irfansofyana/pi-setup",
  "version": "0.8.0",
  "private": true,
  "description": "Irfan's installable Pi coding-agent setup",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-coding-agent"
  ],
  "files": [
    "pi/extensions",
    "pi/themes",
    "pi/prompts",
    "pi/skills",
    "docs/setup",
    "README.md",
    "AGENTS.md"
  ],
  "engines": {
    "node": ">=22.19.0",
    "pi": ">=1.0.0"
  },
  "scripts": {
    "test": "npm run test:package && npm run test:prompts && npm run test:extensions && npm run test:subagent-manager && npm run test:signature",
    "test:package": "node --test --test-concurrency=1 tests/package-contract.test.mjs tests/skill-layout.test.mjs tests/browser-contract.test.mjs",
    "test:prompts": "node --test tests/prompt-templates.test.mjs",
    "test:browser": "node --test --test-concurrency=1 pi/extensions/browser/browser.test.ts pi/extensions/browser/preferences.test.ts tests/browser-contract.test.mjs",
    "test:extensions": "node --experimental-transform-types --test --test-concurrency=1 pi/extensions/*/*.test.ts",
    "test:subagent-manager": "node --experimental-transform-types --test --test-concurrency=1 pi/extensions/subagents/upstream/tests/paths.test.ts pi/extensions/subagents/upstream/tests/manager.test.ts pi/extensions/subagents/upstream/tests/transcript.test.ts pi/extensions/subagents/upstream/tests/startup.test.ts pi/extensions/subagents/upstream/tests/spawn-timeout.test.ts pi/extensions/subagents/upstream/tests/cost-ledger.test.ts pi/extensions/subagents/upstream/tests/status-ui.test.ts pi/extensions/subagents/upstream/tests/live-agent-view.test.ts",
    "test:signature": "node --test --test-concurrency=1 pi/themes/pi-irfan-devs/*.test.ts",
    "test:themes": "node pi/themes/pi-irfan-devs/smoke-test.mjs"
  },
  "pi": {
    "extensions": [
      "./pi/themes/pi-irfan-devs/index.ts",
      "./pi/extensions/*/index.ts"
    ],
    "skills": [
      "./pi/skills"
    ],
    "prompts": [
      "./pi/prompts/*.md"
    ],
    "themes": [
      "./pi/themes/*.json",
      "./pi/themes/pi-irfan-devs/theme.json"
    ]
  },
  "piSetup": {
    "defaultTheme": "pi-irfan-devs",
    "requiredPackages": [
      "npm:pi-stats-ext@0.2.0",
      "npm:@ff-labs/pi-fff@0.10.5"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "dependencies": {
    "fuzzysort": "4.0.2",
    "shell-quote": "1.8.3",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0",
    "typebox": "1.3.7"
  }
}
